REACT_APP_API_URL=http://127.0.0.1:8080
REACT_APP_COURSE_PILOT=true
DISABLE_ESLINT_PLUGIN=true
# Optional. Without a map key, text-based location reporting still works.
REACT_APP_GOOGLE_MAPS_API_KEY=
# Use a project map ID for deployment; local prototypes can use DEMO_MAP_ID.
REACT_APP_GOOGLE_MAPS_MAP_ID=
